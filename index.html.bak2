        // 辅助：从images提取URL（兼容对象数组格式）
    </script>
    
    <!-- JS Modules -->
    <script src="js/services/baas-client.js"></script>
    <script src="js/services/session.js"></script>
    <script src="js/services/order.js"></script>
    <script src="js/services/history.js"></script>
    <script src="js/services/profit.js"></script>
    <script src="js/services/product.js"></script>
    <script src="js/services/combo.js"></script>
    <script src="js/services/app.js"></script>
    
