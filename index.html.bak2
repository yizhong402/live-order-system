<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>直播订单管理系统</title>
    <link rel="stylesheet" href="css/style.css">
    
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-brand">
                <h1>直播订单管理系统</h1>
                <p>商品库存 · 订单管理</p>
            </div>
            <div class="sidebar-nav" id="sidebarNav">
                <button class="sidebar-btn active" onclick="showPage('home')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span>首页</span></button>
                <button class="sidebar-btn" onclick="showPage('order')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" x2="12" y1="18" y2="12"/><line x1="9" x2="15" y1="15" y2="15"/></svg><span>订单录入</span></button>
                <button class="sidebar-btn" onclick="openProductModal()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" x2="12" y1="22.08" y2="12"/></svg><span>商品管理</span></button>
                <button class="sidebar-btn" onclick="openComboModal()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16"/><path d="M4 20V4"/><path d="M20 20V8"/><path d="M12 20V12"/></svg><span>组合SKU</span></button>
                <button class="sidebar-btn" onclick="showPage('history')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span>历史记录</span></button>
                <button class="sidebar-btn" onclick="showPage('profit')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="1" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><span>毛利计算</span></button>
                <button class="sidebar-btn" onclick="showPage('data')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg><span>数据管理</span></button>
                <button class="sidebar-btn" onclick="openHelpModal()"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" x2="12.01" y1="17" y2="17"/></svg><span>使用说明</span></button>
            </div>
            <div class="sidebar-footer" id="sidebarFooter">PA仓库</div>
        </div>
        <!-- Main area -->
        <div class="main-area">
            <div class="topbar">
                <div class="topbar-left">
                    <span class="topbar-title" id="topbarTitle">首页</span>
                    <div class="topbar-status">
                        <span class="status-dot"></span>
                        <span id="connectionStatus">已连接</span>
                    </div>
                </div>
            </div>
            <div class="page-content">
        <div class="modal-overlay" id="editOrderModal">
            <div class="modal" style="max-width:600px;">
                <h2>✏️ 编辑订单</h2>
                <div class="form-group">
                    <label for="editRound">轮次</label>
                    <input type="number" id="editRound" min="1" style="width:100px;">
                </div>
                <div class="form-group">
                    <label for="editTitle">订单标题</label>
                    <input type="text" id="editTitle" style="width:100%;">
                </div>
                <div class="form-group">
                    <label for="editAuctionPrice">竞拍金额 ($)</label>
                    <input type="number" id="editAuctionPrice" min="0" step="0.01" style="width:150px;">
                </div>
                <div class="form-group">
                    <label for="editOrderNote">备注</label>
                    <input type="text" id="editOrderNote" placeholder="输入备注信息" style="width:100%;">
                </div>
                <div class="form-group">
                    <label>
                        <input type="checkbox" id="editIsOverSold" style="width:auto;margin-right:8px;">
                        <span style="color:#ef4444;">⚠️ 标记为超卖订单</span>
                    </label>
                </div>
                <div class="form-group">
                    <label>SKU列表</label>
                    <div id="editSkuList"></div>
                    <div style="margin-top:10px;">
                        <input type="text" id="editSkuInput" placeholder="添加SKU" style="width:200px;padding:8px;">
                        <button class="btn btn-success" onclick="addEditSku()" style="padding:8px 16px;">添加</button>
                    </div>
                </div>
                <div class="btn-group">
                    <button class="btn btn-success" onclick="saveEditOrder()">保存修改</button>
                    <button class="btn btn-danger" onclick="closeEditModal()">取消</button>
                </div>
            </div>
        </div>
        
        <div class="modal-overlay" id="productModal">
            <div class="modal" style="max-width:800px;">
                <h2>📦 商品库存管理</h2>
                <div class="form-group">
                    <label for="productSku">SKU</label>
                    <input type="text" id="productSku" placeholder="输入商品SKU">
                </div>
                <div class="form-group">
                    <label for="productName">商品名称</label>
                    <input type="text" id="productName" placeholder="输入商品中文名称">
                </div>
                <div class="form-group">
                    <label for="productStock">库存数量</label>
                    <input type="number" id="productStock" min="0" value="10">
                </div>
                <div class="form-group">
                    <label for="productPriceCny">采购价 (人民币)</label>
                    <input type="number" id="productPriceCny" min="0" step="0.01" value="0">
                </div>
                <div class="form-group">
                    <label for="productPriceUsd">采购价 (美金)</label>
                    <input type="number" id="productPriceUsd" min="0" step="0.01" value="0">
                </div>
                <div class="form-group">
                    <label for="productImage">产品图片</label>
                    <input type="file" id="productImage" accept="image/*" onchange="previewImage()">
                    <img id="imagePreview" src="" style="display:none;width:100px;height:100px;margin-top:10px;object-fit:cover;border-radius:4px;">
                </div>
                <div class="btn-group">
                    <button class="btn btn-success" onclick="addProduct()">添加商品</button>
                    <button class="btn btn-primary" onclick="importProducts()">批量导入</button>
                    <button class="btn btn-info" onclick="document.getElementById('xlsxFile').click()" id="xlsxImportBtn">📊 导入Excel(含图片)</button>
                    <input type="file" id="xlsxFile" accept="*" style="display:none;" onchange="importXlsxWithImages()">
                    <button class="btn btn-warning" onclick="cloudImportXlsx()" id="cloudImportBtn">☁️ 云端导入(支持超大文件)</button>
                    <input type="file" id="cloudXlsxFile" accept=".xlsx,.xls" style="display:none;" onchange="cloudImportFileSelected(event)">
                    <button class="btn btn-warning" onclick="downloadTemplate()">📥 下载模板</button>
                    <button class="btn btn-secondary" onclick="showImageImportTips()">💡 图片导入说明</button>
                    <button class="btn btn-secondary" onclick="checkXlsxLibrary()">🔧 诊断XLSX</button>
                    <button class="btn btn-secondary" onclick="checkJSZipLibrary()">🔧 诊断JSZip</button>
                <button class="btn btn-info" onclick="openImageMatchModal()" id="imageMatchBtn" style="display:none;">🔄 调整图片匹配</button>
                <button class="btn btn-danger" onclick="deleteAllProducts()" style="background:#c0392b;">🗑️ 删除全部商品</button>
                <button class="btn btn-danger" onclick="closeProductModal()">关闭</button>
                </div>
                <div id="importProgress" style="display:none;margin-top:15px;">
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:100%;height:20px;background:rgba(255,255,255,0.2);border-radius:10px;overflow:hidden;">
                            <div id="progressBar" style="height:100%;background:linear-gradient(90deg,#4CAF50,#8BC34A);width:0%;transition:width 0.3s ease;"></div>
                        </div>
                        <span id="progressText" font-size:14px;">0%</span>
                    </div>
                    <div id="progressMessage" style="margin-top:8px;color:rgba(255,255,255,0.6);font-size:13px;"></div>
                </div>
                <div id="productStats" style="margin-top:15px;padding:12px;background:rgba(0,0,0,0.2);border-radius:8px;">
                    <div style="display:flex;flex-wrap:wrap;gap:20px;font-size:13px;">
                        <div><span style="color:#4CAF50;">📦 商品总数:</span> <strong id="statsTotal" style="color:#ffffff;font-size:16px;font-weight:800;">-</strong></div>
                        <div><span style="color:#FF9800;">🖼️ 无图片:</span> <strong id="statsNoImage" style="color:#ffffff;font-size:16px;font-weight:800;">-</strong></div>
                        <div><span style="color:#f44336;">💰 无价格:</span> <strong id="statsNoPrice" style="color:#ffffff;font-size:16px;font-weight:800;">-</strong></div>
                    </div>
                    <div style="margin-top:10px;">
                        <button class="btn btn-warning" style="padding:4px 12px;font-size:12px;" onclick="downloadProductsWithIssues()">📥 下载问题商品</button>
                    </div>
                </div>
                <div style="margin-top:20px;">
                    <h3>商品列表</h3>
                    <div id="productList" style="max-height:300px;overflow-y:auto;"></div>
                </div>
            </div>
        </div>
        
        <div class="modal-overlay" id="editProductModal">
            <div class="modal" style="max-width:600px;">
                <h2>✏️ 编辑商品信息</h2>
                <input type="hidden" id="editProductIndex">
                <div class="form-group">
                    <label for="editProductSku">SKU</label>
                    <input type="text" id="editProductSku" placeholder="输入商品SKU" readonly>
                </div>
                <div class="form-group">
                    <label for="editProductName">商品名称</label>
                    <input type="text" id="editProductName" placeholder="输入商品中文名称">
                </div>
                <div class="form-group">
                    <label for="editProductStock">库存数量</label>
                    <input type="number" id="editProductStock" min="0" value="10">
                </div>
                <div class="form-group">
                    <label for="editProductPriceCny">采购价 (人民币)</label>
                    <input type="number" id="editProductPriceCny" min="0" step="0.01" value="0">
                </div>
                <div class="form-group">
                    <label for="editProductPriceUsd">采购价 (美金)</label>
                    <input type="number" id="editProductPriceUsd" min="0" step="0.01" value="0">
                </div>
                <div class="form-group">
                    <label for="editProductImage">产品图片</label>
                    <input type="file" id="editProductImage" accept="image/*" onchange="previewEditImage()">
                    <img id="editImagePreview" src="" style="display:none;width:120px;height:120px;margin-top:10px;object-fit:cover;border-radius:4px;">
                    <button class="btn btn-secondary" style="margin-top:5px;padding:4px 10px;font-size:12px;" onclick="clearEditImage()">清除图片</button>
                </div>
                <div class="btn-group">
                    <button class="btn btn-success" onclick="saveEditProduct()">保存修改</button>
                    <button class="btn btn-danger" onclick="closeEditProductModal()">取消</button>
                </div>
            </div>
        </div>

        <div class="modal-overlay" id="imageMatchModal">
            <div class="modal" style="max-width:1200px;">
                <h2>🔄 调整图片匹配</h2>
                <p font-size:14px;margin-bottom:15px;">点击商品图片可以选择其他图片进行匹配</p>
                <div id="imageMatchGrid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:15px;max-height:500px;overflow-y:auto;"></div>
                <div class="btn-group" style="margin-top:20px;">
                    <button class="btn btn-success" onclick="saveImageMatch()">保存匹配</button>
                    <button class="btn btn-primary" onclick="resetImageMatch()">重置匹配</button>
                    <button class="btn btn-danger" onclick="closeImageMatchModal()">关闭</button>
                </div>
            </div>
        </div>
        
        <div class="modal-overlay" id="comboModal">
            <div class="modal" style="max-width:800px;">
                <h2 style="color:#fff;">🔗 组合 SKU 管理</h2>
                <div class="form-group">
                    <label for="comboSearch" >搜索组合（输入组合编码或任意 SKU）</label>
                    <input type="text" id="comboSearch" placeholder="搜索组合编码或组合内的 SKU..." oninput="searchCombo()">
                </div>
                <div id="comboSearchResult" style="margin-bottom:15px;padding:15px;background:rgba(16,185,129,0.1);border-radius:8px;display:none;"></div>
                <div class="form-group">
                    <label for="comboCode" >组合编码</label>
                    <input type="text" id="comboCode" placeholder="例如：ABBB">
                </div>
                <div class="form-group">
                    <label for="comboSkuInput" >扫描添加 SKU（扫码枪输入）</label>
                    <input type="text" id="comboSkuInput" placeholder="扫描 SKU 码，按回车添加" onkeypress="if(event.key==='Enter') addComboSku()">
                </div>
                <div class="btn-group">
                    <button class="btn btn-success" onclick="addComboSku()">添加 SKU</button>
                    <button class="btn btn-primary" onclick="saveCombo()">保存组合</button>
                    <button class="btn btn-danger" onclick="closeComboModal()">关闭</button>
                </div>
                <div style="margin-top:15px;">
                    <h4 style="color:#fff;">当前组合包含的 SKU：</h4>
                    <div id="currentComboSkus" style="max-height:200px;overflow-y:auto;margin-bottom:15px;"></div>
                </div>
                <div style="margin-top:20px;">
                    <h3 style="color:#fff;">已有组合列表</h3>
                    <div id="comboList"></div>
                </div>
            </div>
        </div>
        
        <div class="modal-overlay" id="comboEditModal">
            <div class="modal" style="max-width:800px;">
                <h2 style="color:#fff;">🔗 编辑组合 SKU</h2>
                <div class="form-group">
                    <label for="editComboCode" >组合编码</label>
                    <input type="text" id="editComboCode" readonly>
                </div>
                <div class="form-group">
                    <label for="editComboSkuInput" >扫描添加 SKU（扫码枪输入）</label>
                    <input type="text" id="editComboSkuInput" placeholder="扫描 SKU 码，按回车添加" onkeypress="if(event.key==='Enter') addEditComboSku()">
                </div>
                <div class="btn-group">
                    <button class="btn btn-success" onclick="addEditComboSku()">添加 SKU</button>
                    <button class="btn btn-primary" onclick="saveEditCombo()">保存修改</button>
                    <button class="btn btn-danger" onclick="closeComboEditModal()">关闭</button>
                </div>
                <div style="margin-top:15px;">
                    <h4 style="color:#fff;">当前组合包含的 SKU：</h4>
                    <div id="editComboSkus" style="max-height:200px;overflow-y:auto;margin-bottom:15px;"></div>
                </div>
            </div>
        </div>
        
        <div class="modal-overlay" id="sessionModal">
            <div class="modal">
                <h2 style="color:#fff;">创建直播场次</h2>
                <div class="form-group">
                    <label for="sessionTitle" >直播标题</label>
                    <input type="text" id="sessionTitle" placeholder="输入直播标题">
                </div>
                <div class="form-group">
                    <label for="sessionDate" >直播日期</label>
                    <input type="date" id="sessionDate">
                </div>
                <div class="form-group">
                    <label for="sessionTimeInput" >直播时间</label>
                    <input type="time" id="sessionTimeInput">
                </div>
                <div class="form-group">
                    <label for="anchorName" >主播名字</label>
                    <input type="text" id="anchorName" placeholder="输入主播名字">
                </div>
                <div class="btn-group">
                    <button class="btn btn-success" onclick="createSession()">创建</button>
                    <button class="btn btn-danger" onclick="closeSessionModal()">取消</button>
                </div>
            </div>
        </div>
                <div id="page-home" class="page active">
                    <div class="panel" style="text-align:center;padding:32px 20px;">
                        <div style="font-size:36px;margin-bottom:12px;opacity:0.7;">📊</div>
                        <h2 style="font-size:18px;font-weight:600;color:var(--text-primary);margin-bottom:4px;">直播订单管理系统</h2>
                        <p style="color:var(--text-muted);margin-bottom:24px;font-size:13px;">一站式直播订单管理解决方案</p>
                        
                        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:800px;margin:0 auto;">
                            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px 12px;cursor:pointer;transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--border-hover)'" onmouseleave="this.style.borderColor='var(--border)'" onclick="showPage('order')">
                                <div style="font-size:24px;margin-bottom:8px;">📝</div>
                                <div style="color:var(--text-primary);font-weight:500;margin-bottom:4px;">订单录入</div>
                                <div style="color:var(--text-muted);font-size:12px;">扫码录入竞拍订单</div>
                            </div>
                            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px 12px;cursor:pointer;transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--border-hover)'" onmouseleave="this.style.borderColor='var(--border)'" onclick="openProductModal()">
                                <div style="font-size:24px;margin-bottom:8px;">📦</div>
                                <div style="color:var(--text-primary);font-weight:500;margin-bottom:4px;">商品管理</div>
                                <div style="color:var(--text-muted);font-size:12px;">管理商品库存信息</div>
                            </div>
                            <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:20px 12px;cursor:pointer;transition:all 0.2s;" onmouseenter="this.style.borderColor='var(--border-hover)'" onmouseleave="this.style.borderColor='var(--border)'" onclick="openComboModal()">
                                <div style="font-size:24px;margin-bottom:8px;">🔗</div>
                                <div style="color:var(--text-primary);font-weight:500;margin-bottom:4px;">组合SKU</div>
                                <div style="color:var(--text-muted);font-size:12px;">创建商品套餐组合</div>
                            </div>
                        </div>
                        
                        <div style="margin-top:20px;display:flex;gap:8px;justify-content:center;">
                            <button class="btn btn-primary" onclick="showPage('order')">开始录入订单</button>
                            <button class="btn btn-outline" style="font-size:12px;" onclick="initializeApp()">🔄 初始化数据</button>
                        </div>
                    </div>
                </div>
                
                <div id="page-order" class="page">
                    <div class="order-layout" style="display:flex;gap:15px;height:100%;">
                        <div class="panel" style="flex:1;overflow-y:auto;">
                        <div class="panel-title">📝 当前竞拍设置</div>
                        
                        <!-- 场次信息区域 -->
                        <div class="session-panel" id="sessionPanel" style="margin-bottom:15px;padding:15px;background:rgba(255,255,255,0.05);border-radius:10px;">
                            <div id="noSession" style="display:flex;justify-content:space-between;align-items:center;">
                                <h3>📅 还没有创建直播场次</h3>
                                <button class="create-session-btn" onclick="openSessionModal()">创建直播场次</button>
                            </div>
                            <div id="activeSession" style="display:none;">
                                <div style="display:flex;justify-content:space-between;align-items:center;">
                                    <div>
                                        <h3>🎬 当前直播场次</h3>
                                        <div class="session-info" style="display:flex;gap:20px;">
                                            <div class="session-info-item">
                                                <span class="session-info-label">直播时间:</span>
                                                <span class="session-info-value" id="sessionTime">-</span>
                                            </div>
                                            <div class="session-info-item">
                                                <span class="session-info-label">主播:</span>
                                                <span class="session-info-value" id="sessionAnchor">-</span>
                                            </div>
                                        </div>
                                    </div>
                                    <button class="create-session-btn" onclick="openSessionModal()">更换场次</button>
                                </div>
                            </div>
                        </div>
                        
                        <div class="btn-group" style="margin-bottom:15px;">
                            <button class="btn btn-success" onclick="openProductModal()">📦 商品管理</button>
                            <button class="btn btn-primary" onclick="openComboModal()">🔗 组合SKU</button>
                            <button class="btn btn-warning" onclick="endLive()">🚫 结束直播</button>
                        </div>
                        
                        <div class="form-group">
                            <label for="baseTitle">竞拍链接名称</label>
                            <div style="display:flex;gap:8px;">
                                <input type="text" id="baseTitle" placeholder="例如: kawaii bundle 1LB(确保与当前竞拍链接名称一致)" oninput="updateCurrentTitle()" style="flex:1;">
                                <select id="titleHistorySelect" onchange="selectFromHistory()" style="flex:0 0 200px;padding:8px;border-radius:8px;border:2px solid rgba(102, 126, 234, 0.5);background:rgba(255,255,255,0.1);color:#fff;font-size:14px;cursor:pointer;">
                                    <option value="">历史链接...</option>
                                </select>
                                <button class="btn btn-warning" style="padding:8px 12px;font-size:14px;" onclick="openTitleHistoryModal()">📋 管理</button>
                            </div>
                        </div>
                        
                        <div style="display:flex;gap:20px;">
                            <div class="form-group" style="flex:1;">
                                <label for="auctionPrice">竞拍金额 ($)</label>
                                <input type="number" id="auctionPrice" placeholder="输入本轮竞拍金额（选填）" min="0" step="0.01">
                            </div>
                            
                            <div class="form-group" style="flex:1;">
                                <label for="orderNote">订单备注</label>
                                <input type="text" id="orderNote" placeholder="输入备注信息（选填）" style="background:rgba(255,255,255,0.1);">
                            </div>
                        </div>
                        
                        <div class="btn-group">
                            <button class="btn btn-warning" onclick="prevRound()">上一轮 (-)</button>
                            <button class="btn btn-primary" onclick="nextRound()">下一轮 (+)</button>
                            <button class="btn btn-danger" onclick="resetRound()">重置轮次</button>
                        </div>
                        
                        <div class="scan-indicator" id="scanIndicator">
                            <p>🎯 准备好扫码枪，将光标放在输入框中扫描</p>
                        </div>
                        
                        <div class="form-group">
                            <label for="skuInput">SKU扫描区 (扫码枪自动输入)</label>
                            <input type="text" id="skuInput" placeholder="扫描SKU码..." autofocus>
                        </div>
                        
                        <div class="btn-group">
                            <button class="btn btn-success" onclick="addSku()">添加SKU</button>
                            <button class="btn btn-primary" onclick="saveOrder()">保存当前轮次订单</button>
                            <button class="btn btn-danger" onclick="clearSkus()">清空当前轮次SKU</button>
                        </div>
                        

                        
                        <div class="sku-list" id="skuList"></div>
                    </div>
                    
                    <div class="panel" style="flex:0 0 420px;display:flex;flex-direction:column;">
                        <div class="panel-title">📋 实时订单记录</div>
                        
                        <!-- 当前竞拍信息 - 一行显示 -->
                        <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px;background:rgba(255,255,255,0.05);border-radius:8px;margin-bottom:15px;">
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span font-size:13px;">轮次:</span>
                                <div style="display:flex;align-items:center;gap:5px;">
                                    <input type="number" id="currentRoundInput" value="1" min="1" style="width:50px;padding:3px;border-radius:4px;border:1px solid rgba(255,255,255,0.2);background:rgba(255,255,255,0.1);color:#fff;text-align:center;font-size:13px;" onkeypress="if(event.key==='Enter') jumpToRound()">
                                    <button class="btn btn-success" style="padding:3px 8px;font-size:11px;" onclick="jumpToRound()">跳转</button>
                                </div>
                            </div>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span font-size:13px;">标题:</span>
                                <span style="color:#fff;font-weight:600;font-size:13px;" id="currentTitle">-</span>
                            </div>
                            <div style="display:flex;align-items:center;gap:8px;">
                                <span font-size:13px;">SKU:</span>
                                <span style="color:#10b981;font-weight:600;font-size:13px;" id="skuCount">0</span>
                            </div>
                        </div>
                        
                        <div class="form-group" style="margin-bottom:20px;">
                            <label for="orderRoundFilter">按轮次查询</label>
                            <div style="display:flex;gap:10px;">
                                <input type="number" id="orderRoundFilter" placeholder="输入轮次" min="1" oninput="filterOrdersRealTime()" style="flex:1;">
                                <button class="btn btn-primary" onclick="clearOrderFilter()">清除筛选</button>
                            </div>
                        </div>
                        
                        <div class="btn-group">
                            <button class="btn btn-success" onclick="exportOrders()">导出CSV</button>
                            <button class="btn btn-danger" onclick="clearAllOrders()">清空所有订单</button>
                        </div>
                        
                        <div class="order-list" id="realTimeOrderList" style="flex:1;overflow-y:auto;"></div>
                    </div>
                    </div>
                </div>
                
                <div id="page-combo" class="page">
                    <div class="panel">
                        <div class="panel-title">🔗 组合SKU管理</div>
                        
                        <div class="form-group">
                            <label for="comboCode">组合编码</label>
                            <input type="text" id="comboCode" placeholder="例如: COMBO001">
                        </div>
                        
                        <div class="form-group">
                            <label for="comboSkuInput">扫描添加 SKU（扫码枪输入）</label>
                            <input type="text" id="comboSkuInput" placeholder="扫描 SKU 码，按回车添加" onkeypress="if(event.key==='Enter') addComboSku()">
                        </div>
                        
                        <div class="btn-group">
                            <button class="btn btn-success" onclick="addComboSku()">添加 SKU</button>
                            <button class="btn btn-primary" onclick="saveCombo()">保存组合</button>
                            <button class="btn btn-danger" onclick="resetCombo()">清空</button>
                        </div>
                        
                        <div style="margin-top:20px;">
                            <h4>当前组合包含的 SKU：</h4>
                            <div id="currentComboSkus" style="max-height:200px;overflow-y:auto;margin-bottom:15px;"></div>
                        </div>
                        
                        <div style="margin-top:20px;">
                            <h4>已有组合列表</h4>
                            <div id="comboList"></div>
                        </div>
                    </div>
                </div>
                
                <div id="page-history" class="page">
                    <div class="panel">
                        <div class="panel-title">📋 历史记录</div>
                        
                        <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                            <h4 style="margin-bottom:10px;color:#4CAF50;">🎬 直播场次列表</h4>
                            <div id="sessionList" style="max-height:150px;overflow-y:auto;"></div>
                            <button class="btn btn-success" style="margin-top:10px;" onclick="endCurrentSession()">🎉 结束当前场次</button>
                        </div>
                        
                        <div class="form-group">
                            <label for="sessionSelect">选择直播场次</label>
                            <select id="sessionSelect" onchange="selectSessionFromDropdown()">
                                <option value="">全部场次</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="sessionTitleFilter">按直播标题查询</label>
                            <input type="text" id="sessionTitleFilter" placeholder="输入直播标题">
                        </div>
                        
                        <div class="form-group">
                            <label for="anchorFilter">按主播名字查询</label>
                            <input type="text" id="anchorFilter" placeholder="输入主播名字">
                        </div>
                        
                        <div class="form-group">
                            <label for="dateFilter">按日期筛选</label>
                            <input type="date" id="dateFilter">
                        </div>
                        
                        <div class="btn-group">
                            <button class="btn btn-primary" onclick="filterSessions()">🔍 查询场次</button>
                            <button class="btn btn-secondary" onclick="clearFilter()">清除筛选</button>
                        </div>
                        
                        <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                            <h4 style="margin-bottom:10px;color:#4CAF50;">🎬 筛选后的场次列表</h4>
                            <div id="filteredSessionList" style="max-height:200px;overflow-y:auto;"></div>
                        </div>
                        
                        <div class="btn-group">
                            <button class="btn btn-success" onclick="exportOrders()">导出CSV</button>
                            <button class="btn btn-danger" onclick="clearAllOrders()">清空所有订单</button>
                            <button class="btn btn-warning" onclick="clearAllLiveData()">🗑️ 删除所有直播数据</button>
                        </div>
                        
                        <div class="order-list" id="orderList" style="max-height:400px;"></div>
                    </div>
                </div>
                
                <div id="page-profit" class="page">
                    <div class="panel">
                        <div class="panel-title">💰 毛利计算</div>
                        
                        <div style="display:flex;gap:20px;">
                            <!-- 左侧设置区域 -->
                            <div style="flex:1;">
                                <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                                    <h4 style="margin-bottom:15px;color:#667eea;">⚙️ 手续费设置</h4>
                                    <div class="form-group">
                                        <label for="feeRate">平台手续费比例 (%)</label>
                                        <div style="display:flex;align-items:center;gap:10px;">
                                            <input type="number" id="feeRate" min="0" max="100" step="0.1" value="10" style="flex:1;">
                                            <span ">%</span>
                                        </div>
                                        <p style="color:rgba(255,255,255,0.5);font-size:12px;margin-top:5px;">实际GMV = 竞拍金额 × (100% - 手续费比例)</p>
                                    </div>
                                </div>
                                
                                <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                                    <h4 style="margin-bottom:15px;color:#667eea;">💰 手动输入GMV（可选）</h4>
                                    <div class="form-group">
                                        <label for="manualGMV">当场GMV金额 ($)</label>
                                        <div style="display:flex;align-items:center;gap:10px;">
                                            <span style="color:#f59e0b;">$</span>
                                            <input type="number" id="manualGMV" min="0" step="0.01" placeholder="如：1250.00" style="flex:1;">
                                        </div>
                                        <p style="color:rgba(255,255,255,0.5);font-size:12px;margin-top:5px;">若填写此项，将使用手动输入的GMV进行计算，不计算订单金额</p>
                                    </div>
                                </div>
                                
                                <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                                    <h4 style="margin-bottom:15px;color:#667eea;">📅 时间范围</h4>
                                    <div style="display:flex;gap:10px;">
                                        <input type="date" id="customStartDate" style="flex:1;padding:8px;border-radius:6px;border:2px solid rgba(102, 126, 234, 0.5);background:rgba(255,255,255,0.1);color:#fff;font-size:14px;">
                                        <span style="color:rgba(255,255,255,0.5);display:flex;align-items:center;">~</span>
                                        <input type="date" id="customEndDate" style="flex:1;padding:8px;border-radius:6px;border:2px solid rgba(102, 126, 234, 0.5);background:rgba(255,255,255,0.1);color:#fff;font-size:14px;">
                                    </div>
                                </div>
                                
                                <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                                    <h4 style="margin-bottom:15px;color:#667eea;">📅 选择场次</h4>
                                    <select id="profitSessionSelect" onchange="calculateProfit()" style="width:100%;padding:10px;border-radius:8px;border:2px solid rgba(102, 126, 234, 0.5);background:rgba(255,255,255,0.1);color:#fff;font-size:14px;">
                                        <option value="">全部场次汇总</option>
                                    </select>
                                </div>
                                
                                <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                                    <h4 style="margin-bottom:15px;color:#ff9800;">⚠️ 未设置采购价的SKU</h4>
                                    <div id="missingPriceSkus" style="max-height:150px;overflow-y:auto;color:rgba(255,255,255,0.7);font-size:12px;">
                                        <div style="color:rgba(255,255,255,0.4);">点击计算后显示未设置采购价的SKU</div>
                                    </div>
                                </div>
                                
                                <div class="btn-group" style="gap:8px;">
                                    <button class="btn btn-primary" style="flex:1;padding:12px;" onclick="calculateProfit()">🔄 重新计算</button>
                                    <button class="btn btn-success" style="flex:1;padding:12px;" onclick="exportProfitData()">📤 导出数据</button>
                                </div>
                            </div>
                            
                            <!-- 右侧结果展示 -->
                            <div style="flex:2;">
                                <div id="profitResult" style="padding:20px;background:linear-gradient(135deg,rgba(76, 175, 80, 0.1) 0%,rgba(76, 175, 80, 0.05) 100%);border:1px solid rgba(76, 175, 80, 0.3);border-radius:12px;">
                                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                                        <h4 style="color:#4CAF50;font-size:18px;">📊 毛利计算结果</h4>
                                        <div id="timeRangeDisplay" font-size:14px;"></div>
                                    </div>
                                    <div id="profitDetails"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div id="page-data" class="page">
                    <div class="panel">
                        <div class="panel-title">💾 数据管理</div>
                        
                        <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                            <h4 style="margin-bottom:10px;color:#667eea;">📤 导出全部数据</h4>
                            <p margin-bottom:10px;">将所有数据（商品、订单、组合、历史记录等）导出到JSON文件，可在另一台电脑导入</p>
                            <button class="btn btn-success" style="width:100%;" onclick="exportAllData()">📤 导出数据</button>
                        </div>
                        
                        <div style="margin-bottom:20px;padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                            <h4 style="margin-bottom:10px;color:#667eea;">📥 导入数据</h4>
                            <p margin-bottom:10px;">选择之前导出的JSON文件，将数据导入到当前浏览器</p>
                            <input type="file" id="importFileInput" accept=".json" style="display:none;" onchange="importAllData(event)">
                            <button class="btn btn-primary" style="width:100%;" onclick="document.getElementById('importFileInput').click()">📥 导入数据</button>
                        </div>
                        
                        <div style="padding:15px;background:rgba(0,0,0,0.2);border-radius:8px;">
                            <h4 style="margin-bottom:10px;color:#667eea;">📊 当前数据统计</h4>
                            <div id="dataStats" "></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="modal-overlay" id="helpModal">
        <div class="modal" style="max-width:800px;max-height:80vh;overflow-y:auto;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                <h2 style="color:#fff;">📖 使用说明</h2>
                <button class="btn btn-close" onclick="closeHelpModal()">✕</button>
            </div>
            
            <div id="helpContent" style="font-size:14px;line-height:1.8;color:#e0e0e0;">
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🚀 版本更新 v2.4</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">📦 系统更名升级</strong>: 从"直播竞拍订单系统"升级为"直播订单管理系统"</li>
                    <li><strong style="color:#ffffff;">🎨 界面布局优化</strong>: 订单列表卡片样式全新设计，渐变背景、阴影效果更美观</li>
                    <li><strong style="color:#ffffff;">🪟 模态框管理优化</strong>: 自动关闭叠加窗口，避免多层弹窗叠加导致界面混乱</li>
                                        <li><strong style="color:#ffffff;">📋 首页信息更新</strong>: 更全面的系统描述，体现多平台管理特性</li>
                    <li><strong style="color:#ffffff;">🔧 订单编辑修复</strong>: 修复编辑订单时输入框ID冲突问题，编辑功能正常工作</li>
                    <li><strong style="color:#ffffff;">⚠️ 重复订单号检测</strong>: 同一场次内自动检测重复订单号，避免录入错误</li>
                    <li><strong style="color:#ffffff;">🗑️ 场次删除优化</strong>: 增强数据修复能力，自动处理损坏的场次数据</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🚀 版本更新 v2.3</h3>
                <ul style="color:#d0d0d0;">
                                        <li><strong style="color:#ffffff;">📅 场次管理增强</strong>: 支持创建直播场次、设置主播名字、订单按场次保存</li>
                    <li><strong style="color:#ffffff;">📸 摄像头权限优化</strong>: 一场直播仅询问一次摄像头权限，无需重复授权</li>
                    <li><strong style="color:#ffffff;">🖼️ 多图片支持</strong>: 一个订单支持多张商品图片，支持拍照和上传</li>
                    <li><strong style="color:#ffffff;">✏️ 订单编辑功能</strong>: 支持修改订单号、备注信息和图片（添加/删除/替换）</li>
                    <li><strong style="color:#ffffff;">🌐 HTML导出优化</strong>: 支持带高清图片的HTML格式导出，完美展示订单信息</li>
                    <li><strong style="color:#ffffff;">➡️ 下一个订单</strong>: 保存当前订单后自动清空表单，快速录入下一个</li>
                    <li><strong style="color:#ffffff;">🔍 场次查询</strong>: 新增场次查询按钮，快速查看特定场次订单</li>
                    <li><strong style="color:#ffffff;">🗑️ 删除场次</strong>: 支持删除历史场次，同步删除对应订单数据</li>
                    <li><strong style="color:#ffffff;">⚠️ 重复订单号检测</strong>: 自动检测重复订单号，避免录入错误</li>
                    <li><strong style="color:#ffffff;">🎨 界面布局优化</strong>: 场次查询框移至右侧，创建/更换场次按钮移至左侧，操作更便捷</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🚀 版本更新 v2.2</h3>
                <ul style="color:#d0d0d0;">
                                        <li><strong style="color:#ffffff;">📅 场次管理</strong>: 创建直播场次、设置主播名字、订单按场次保存</li>
                    <li><strong style="color:#ffffff;">📸 摄像头权限优化</strong>: 一场直播仅询问一次摄像头权限，无需重复授权</li>
                    <li><strong style="color:#ffffff;">🖼️ 多图片支持</strong>: 一个订单支持多张商品图片，支持拍照和上传</li>
                    <li><strong style="color:#ffffff;">✏️ 订单编辑</strong>: 支持修改订单号、备注信息和图片（添加/删除/替换）</li>
                    <li><strong style="color:#ffffff;">📊 多种导出格式</strong>: 支持Excel(XLSX)、HTML(带高清图片)、CSV三种格式导出</li>
                    <li><strong style="color:#ffffff;">🔚 直播结束</strong>: 一键结束当前场次，自动保存订单记录</li>
                    <li><strong style="color:#ffffff;">🗑️ 删除场次</strong>: 支持删除历史场次，同步删除对应订单数据</li>
                    <li><strong style="color:#ffffff;">➡️ 下一个订单</strong>: 保存当前订单后自动清空表单，快速录入下一个</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🚀 版本更新 v2.1</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">💰 毛利统计板块</strong>: 全新的毛利计算功能，支持自定义日期范围统计</li>
                    <li><strong style="color:#ffffff;">📅 灵活时间筛选</strong>: 可自由选择任意日期区间，支持统计到今天或从某天开始</li>
                    <li><strong style="color:#ffffff;">📤 毛利数据导出</strong>: 一键导出毛利报表，包含GMV、手续费、采购成本、毛利等核心数据</li>
                    <li><strong style="color:#ffffff;">⚠️ SKU采购价检查</strong>: 自动检测未设置采购价的SKU，提示补全后再统计</li>
                    <li><strong style="color:#ffffff;">🔢 竞拍链接独立轮次</strong>: 不同链接名称独立计数，切换时自动恢复对应轮次</li>
                    <li><strong style="color:#ffffff;">📋 历史链接下拉</strong>: 支持从下拉框快速选择常用竞拍链接</li>
                    <li><strong style="color:#ffffff;">⚡ 初始化加载动画</strong>: 显示加载进度和状态提示，提升启动体验</li>
                    <li><strong style="color:#ffffff;">📐 订单页面优化</strong>: 实时订单记录移至右侧显示，方便查询</li>
                    <li><strong style="color:#ffffff;">🎯 组合SKU快速调用</strong>: 订单录入页面可直接快速选择组合SKU</li>
                    <li><strong style="color:#ffffff;">🖼️ 图片导入优化</strong>: 修复Excel图片匹配错位问题，支持同一单元格多张图片</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🚀 版本更新 v2.0</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">数据云端存储</strong>: 数据自动保存到云端，多设备共享</li>
                    <li><strong style="color:#ffffff;">商品筛选功能</strong>: 新增无图片、无价格、正常价格等筛选条件</li>
                    <li><strong style="color:#ffffff;">批量删除功能</strong>: 支持按筛选条件批量删除商品</li>
                    <li><strong style="color:#ffffff;">直播历史记录</strong>: 保存每场直播记录，随时查看回放</li>
                    <li><strong style="color:#ffffff;">UI全面优化</strong>: 界面更加美观，提升用户体验</li>
                    <li><strong style="color:#ffffff;">修复数据残留</strong>: 删除商品后刷新不会再恢复</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🔧 功能概览</h3>
                <p style="color:#d0d0d0;">本工具用于管理直播拍卖订单，支持SKU扫描、库存管理、订单记录、毛利统计等功能。</p>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">💰 毛利计算</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">自定义日期范围</strong>: 自由选择任意开始和结束日期，灵活统计</li>
                    <li><strong style="color:#ffffff;">场次筛选</strong>: 可选择特定场次或查看全部场次汇总</li>
                    <li><strong style="color:#ffffff;">手续费设置</strong>: 可配置平台手续费比例，自动计算实际GMV</li>
                    <li><strong style="color:#ffffff;">核心指标</strong>: 展示GMV、手续费、采购成本、毛利、毛利率等</li>
                    <li><strong style="color:#ffffff;">SKU采购价检查</strong>: 自动检测未设置采购价的SKU，提示补全</li>
                    <li><strong style="color:#ffffff;">导出报表</strong>: 一键导出详细毛利数据到CSV文件</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">📦 商品管理</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">添加商品</strong>: 点击"商品管理"按钮，录入SKU、名称、库存、价格等信息</li>
                    <li><strong style="color:#ffffff;">导入商品</strong>: 支持XLSX/CSV批量导入，自动提取图片</li>
                    <li><strong style="color:#ffffff;">统计信息</strong>: 显示商品总数、缺图、缺价的SKU数量，支持下载问题商品</li>
                    <li><strong style="color:#ffffff;">筛选功能</strong>: 支持无图片、无价格、正常价格、库存状态等多维度筛选</li>
                    <li><strong style="color:#ffffff;">批量删除</strong>: 可按筛选条件批量删除商品</li>
                    <li><strong style="color:#ffffff;">编辑/删除</strong>: 在商品列表中可编辑或删除单个商品</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🔗 组合SKU</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">创建组合</strong>: 设置组合编码，添加多个SKU组成套餐</li>
                    <li><strong style="color:#ffffff;">搜索组合</strong>: 输入组合编码或包含的SKU即可搜索</li>
                    <li><strong style="color:#ffffff;">快速添加</strong>: 扫描组合编码自动添加所有包含的SKU</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🎯 订单录入</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">设置标题</strong>: 在"竞拍链接名称"输入竞拍链接名称</li>
                    <li><strong style="color:#ffffff;">扫描SKU</strong>: 将光标放在扫描区，使用扫码枪扫描商品条码</li>
                    <li><strong style="color:#ffffff;">数量管理</strong>: 同一SKU多次扫描自动累加数量</li>
                    <li><strong style="color:#ffffff;">手动修改</strong>: 点击数量数字可直接修改</li>
                    <li><strong style="color:#ffffff;">竞拍金额</strong>: 可记录每轮竞拍金额（选填）</li>
                    <li><strong style="color:#ffffff;">订单备注</strong>: 添加备注信息（选填）</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🔄 轮次管理</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">下一轮</strong>: 点击后自动保存当前轮次订单并进入下一轮</li>
                    <li><strong style="color:#ffffff;">上一轮</strong>: 返回上一轮次继续编辑</li>
                    <li><strong style="color:#ffffff;">跳转轮次</strong>: 快速定位到指定轮次</li>
                    <li><strong style="color:#ffffff;">复制订单</strong>: 将某轮订单复制到指定轮次</li>
                    <li><strong style="color:#ffffff;">自动保存</strong>: 切换轮次时自动保存，无需手动点击</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">📋 订单管理</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">订单列表</strong>: 底部显示所有已保存的订单记录</li>
                    <li><strong style="color:#ffffff;">搜索订单</strong>: 输入轮次数字筛选订单</li>
                    <li><strong style="color:#ffffff;">状态标识</strong>: 
                        <span style="color:#ff4444;">🔴</span> 超卖订单 
                        <span style="color:#ffaa00;">🟡</span> 有备注订单 
                        <span style="color:#44ff44;">🟢</span> 正常订单
                    </li>
                    <li><strong style="color:#ffffff;">快速编辑</strong>: 点击金额或备注可直接修改</li>
                    <li><strong style="color:#ffffff;">导出订单</strong>: 将所有订单导出为CSV文件</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">📊 库存状态</h3>
                <ul style="color:#d0d0d0;">
                    <li><span class="stock-badge stock-green" style="display:inline-block;"></span> <strong style="color:#ffffff;">正常</strong>: 库存充足</li>
                    <li><span class="stock-badge stock-yellow" style="display:inline-block;"></span> <strong style="color:#ffffff;">即将售罄</strong>: 库存少于3件</li>
                    <li><span class="stock-badge stock-red" style="display:inline-block;"></span> <strong style="color:#ffffff;">已售罄</strong>: 库存为0</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">🖼️ 图片功能</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">图片导入</strong>: 支持从XLSX文件批量导入图片，智能匹配单元格位置</li>
                    <li><strong style="color:#ffffff;">智能匹配</strong>: 自动根据图片在Excel中的位置匹配对应SKU，支持同一单元格多张图片</li>
                    <li><strong style="color:#ffffff;">点击放大</strong>: 点击商品图片可全屏查看</li>
                    <li><strong style="color:#ffffff;">自动压缩</strong>: 大图片自动压缩以节省存储空间</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">📺 直播场次</h3>
                <ul style="color:#d0d0d0;">
                    <li><strong style="color:#ffffff;">开始直播</strong>: 设置主播和标题，开始新的直播场次</li>
                    <li><strong style="color:#ffffff;">结束直播</strong>: 结束当前场次，自动保存到历史记录</li>
                    <li><strong style="color:#ffffff;">历史记录</strong>: 查看所有历史直播记录</li>
                </ul>
                
                                    <li><strong style="color:#ffffff;">创建场次</strong>: 点击"📅 创建/更换场次"按钮，设置直播标题、日期、时间和主播名字</li>
                    <li><strong style="color:#ffffff;">选择场次</strong>: 从右侧下拉框选择已有场次，点击"🔍 查询订单"查看该场次订单</li>
                    <li><strong style="color:#ffffff;">录入订单</strong>: 在左侧表单输入订单号，添加备注（可选）</li>
                    <li><strong style="color:#ffffff;">商品图片</strong>: 点击"📷 拍照"调用摄像头或"📁 上传图片"从本地选择，支持多张图片</li>
                    <li><strong style="color:#ffffff;">保存订单</strong>: 点击"💾 保存订单"保存当前订单，表单自动清空；或"➡️ 下一个订单"保存并自动聚焦</li>
                    <li><strong style="color:#ffffff;">订单列表</strong>: 右侧实时显示当前场次的所有订单，支持编辑和删除</li>
                    <li><strong style="color:#ffffff;">编辑订单</strong>: 点击订单旁的编辑按钮，可修改订单号、备注和图片</li>
                    <li><strong style="color:#ffffff;">直播结束</strong>: 点击"🔚 直播结束"按钮保存场次状态</li>
                    <li><strong style="color:#ffffff;">按场次导出</strong>: 选择场次后点击"🌐 HTML网页导出"</li>
                    <li><strong style="color:#ffffff;">删除场次</strong>: 选择场次后点击"🗑️ 删除场次"，同步删除该场次的所有订单</li>
                    <li><strong style="color:#ffffff;">重复订单检测</strong>: 系统自动检测同一场次内的重复订单号，避免录入错误</li>
                    <li><strong style="color:#ffffff;">摄像头权限</strong>: 首次拍照时询问权限，同一场直播无需重复授权</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">💾 数据持久化</h3>
                <ul style="color:#d0d0d0;">
                    <li>所有数据云端存储，安全可靠</li>
                    <li>刷新页面后数据不会丢失</li>
                    <li>支持数据初始化（密码: 1987）</li>
                </ul>
                
                <h3 style="color:#667eea;border-bottom:2px solid #667eea;padding-bottom:8px;margin-top:20px;">⚠️ 注意事项</h3>
                <ul style="color:#d0d0d0;">
                    <li>扫描SKU时确保光标在输入框内</li>
                    <li>超卖订单会自动标记红色，需及时处理</li>
                    <li>建议定期导出订单备份</li>
                    <li>首次使用建议先导入商品数据</li>
                </ul>
                
                <hr style="margin:20px 0;border-color:rgba(255,255,255,0.2);">
                <p style="text-align:center;color:#888888;font-size:12px;">
                    版本: 2.4 | 更新日期: 2026年6月6日
                </p>
            </div>
        </div>
    </div>

    <div class="modal-overlay" id="titleHistoryModal">
        <div class="modal">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
                <h2 style="color:#fff;">📋 历史链接管理</h2>
                <button class="btn btn-close" onclick="closeTitleHistoryModal()">✕</button>
            </div>
            
            <div class="form-group">
                <label for="newTitleInput" >添加新竞拍链接</label>
                <div style="display:flex;gap:8px;">
                    <input type="text" id="newTitleInput" placeholder="输入竞拍链接名称" style="flex:1;">
                    <button class="btn btn-success" onclick="addNewTitle()">添加</button>
                </div>
            </div>
            
            <div style="display:flex;gap:8px;margin-bottom:15px;">
                <button class="btn btn-danger" style="flex:1;" onclick="clearAllTitleHistory()">🗑️ 清空全部历史</button>
            </div>
            
            <div id="titleHistoryList" style="max-height:400px;overflow-y:auto;"></div>
            
            <div style="margin-top:20px;text-align:right;">
                <button class="btn btn-primary" onclick="closeTitleHistoryModal()">关闭</button>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/aipexbase-js/dist/aipexbase.umd.min.js"></script>
