    <script>

        let currentRound = 1;
        let currentSkus = {};
        let orders = [];
        let currentSession = null;
        let products = [];
        let comboSkus = [];
        let liveHistory = [];
        let productImagesCache = {};
        let titleRoundMap = {};  // 存储每个竞拍链接名称对应的最后一轮次
        let lastBaseTitle = '';  // 记录上一次的竞拍链接名称
        let titleHistory = [];   // 存储标题历史记录
        
        let db = null;
        const DB_NAME = 'AuctionDB';
        const DB_VERSION = 4;
        
        // ===== AiPexBase 云端配置 =====
